<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">eckohaus_ip_ledger_form.eckohaus_ip_ledger_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Ledger Case</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Eckohaus\IpLedger\Block\Adminhtml\Ledger\Edit\SaveButton"/>
            <button name="back" class="Eckohaus\IpLedger\Block\Adminhtml\Ledger\Edit\BackButton"/>
        </buttons>
        <namespace>eckohaus_ip_ledger_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>eckohaus_ip_ledger_form.eckohaus_ip_ledger_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="eckohaus_ip_ledger_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="*/*/save"/>
        </settings>
        <dataProvider class="Eckohaus\IpLedger\Model\Ledger\DataProvider" name="eckohaus_ip_ledger_form_data_source">
            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    
    <fieldset name="general">
        <settings>
            <label translate="true">Case Information</label>
        </settings>
        
        <field name="entity_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">ledger</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        
        <field name="case_number" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Case Number</label>
                <dataScope>case_number</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="title_of_work" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Title of Work</label>
                <dataScope>title_of_work</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="status" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <dataScope>status</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options>
                            <option name="open" xsi:type="array">
                                <item name="value" xsi:type="string">Open</item>
                                <item name="label" xsi:type="string">Open</item>
                            </option>
                            <option name="closed" xsi:type="array">
                                <item name="value" xsi:type="string">Closed</item>
                                <item name="label" xsi:type="string">Closed</item>
                            </option>
                        </options>
                    </settings>
                </select>
            </formElements>
        </field>

        <field name="date_opened" formElement="date">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Date Opened</label>
                <dataScope>date_opened</dataScope>
            </settings>
        </field>

        <field name="type_of_work" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Type of Work (Format)</label>
                <dataScope>type_of_work</dataScope>
            </settings>
        </field>

        <field name="jurisdiction" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Jurisdiction</label>
                <dataScope>jurisdiction</dataScope>
            </settings>
        </field>
    </fieldset>
</form>

